---
import { Code } from 'astro:components';
import { CopyButton } from './interior/copy-button';

interface Props {
  code: string;
}

const { code } = Astro.props;
---

<div class="mt-3 border border-neutral-800 bg-[#111113]">
  <div class="flex items-center justify-between border-b border-neutral-800 py-1.5 pr-1.5 pl-4">
    <span class="text-xs text-neutral-400">Terminal</span>
    <CopyButton client:visible value={code} />
  </div>
  <!-- Colours are added at build time -->
  <Code
    code={code}
    lang="bash"
    theme="github-dark"
    class="overflow-x-auto p-4 text-sm"
  />
</div>
