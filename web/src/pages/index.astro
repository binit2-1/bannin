---
import Docs from '../components/Docs.astro';
import Features from '../components/Features.astro';
import { HeaderActions } from '../components/HeaderActions';
import Layout from '../layouts/Layout.astro';

const title = 'Bannin';
const description =
  'A memory watchman for KDE Plasma on Linux. Bannin shows RAM and swap in your panel, warns you before the system runs out of memory and freezes, and can stop dev tools you forgot about (Metro, Gradle daemons, the Android emulator).';
---

<Layout title={title} description={description}>
  <main class="mx-auto max-w-199 text-justify">
    <header class="flex items-center justify-between">
      <h1
        class="relative isolate w-fit cursor-pointer text-3xl font-extralight transition-colors duration-300 ease-in-out before:absolute before:inset-0 before:-z-10 before:origin-bottom before:scale-y-0 before:bg-[#0015FF] before:transition-transform before:duration-300 before:ease-in-out hover:text-[#FAFAFA] hover:before:scale-y-100"
      >
        {title}
      </h1>
      <HeaderActions client:load githubUrl="https://github.com/binit2-1/bannin" />
    </header>

    <p class="mt-16 text-base font-light">{description}</p>

    <Docs>
      <Features />
    </Docs>
  </main>
</Layout>
